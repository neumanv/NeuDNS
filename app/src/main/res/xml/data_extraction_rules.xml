<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: solo se copia la configuración (apps elegidas y servidor), nada más. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="config.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="config.xml" />
    </device-transfer>
</data-extraction-rules>
