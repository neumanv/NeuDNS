<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de la lista: resaltada cuando la app está elegida (estado «activated»). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector android:enterFadeDuration="150" android:exitFadeDuration="150">
            <item android:state_activated="true">
                <shape>
                    <solid android:color="@color/accent_soft" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/surface" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
