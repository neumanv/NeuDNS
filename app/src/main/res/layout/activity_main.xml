<?xml version="1.0" encoding="utf-8"?>
<!--
    La lista ocupa toda la pantalla y la cabecera va encima. Al desplazar la lista, la cabecera
    sube y en su lugar queda una barra compacta con el estado y el botón; el buscador sigue fijo.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:paddingHorizontal="16dp">

    <ListView
        android:id="@+id/apps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <!-- Cabecera completa: deja pasar el desplazamiento a la lista salvo en sus controles. -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/expanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/on_surface"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:text="@string/intro"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <!-- Apps instaladas que no se ofrecen porque sus anuncios no se pueden bloquear -->
            <TextView
                android:id="@+id/unblockable_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Estado, botón principal y servidor -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:animateLayoutChanges="true"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/status_dot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_dot" />

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Consultas y bloqueos desde que se encendió, solo en memoria -->
                <TextView
                    android:id="@+id/stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:paddingTop="4dp"
                    android:textColor="@color/muted"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_message"
                    android:padding="12dp"
                    android:textColor="@color/warn"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/toggle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_button_start"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:textColor="@color/on_accent"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Pausar o reanudar el bloqueo sin apagar el filtro -->
                <TextView
                    android:id="@+id/pause"
                    style="@style/CardRow"
                    android:layout_marginTop="6dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/provider_label"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/provider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:popupBackground="@drawable/bg_card" />

                <!-- Dirección del servidor personalizado: solo si está seleccionado -->
                <TextView
                    android:id="@+id/custom_server"
                    style="@style/CardRow"
                    android:visibility="gone" />

                <!-- Dominios que no se bloquean: abre la lista para añadir o quitar -->
                <TextView
                    android:id="@+id/exceptions"
                    style="@style/CardRow" />

                <!-- Dominios que se bloquean además de los del servidor -->
                <TextView
                    android:id="@+id/blocked"
                    style="@style/CardRow" />

                <!-- Últimos dominios bloqueados, para saber qué permitir si una app falla -->
                <TextView
                    android:id="@+id/diagnostics"
                    style="@style/CardRow" />
            </LinearLayout>
        </LinearLayout>

        <!-- Buscador: siempre visible -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/muted"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Barra compacta: aparece cuando la cabecera se ha recogido. -->
    <LinearLayout
        android:id="@+id/compact"
        android:layout_width="match_parent"
        android:layout_height="@dimen/compact_bar_height"
        android:alpha="0"
        android:background="@color/bg"
        android:clickable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="invisible">

        <View
            android:id="@+id/compact_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_dot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/app_name"
            android:textColor="@color/on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/compact_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/compact_toggle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_start"
            android:minWidth="0dp"
            android:paddingHorizontal="18dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
